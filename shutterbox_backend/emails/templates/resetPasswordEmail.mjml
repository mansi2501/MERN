<mjml>
  <mj-head>
    <mj-title>Reset Your Password</mj-title>
    <mj-preview>Click below to reset your password</mj-preview>
    <mj-style inline="inline">
      .button-primary { background-color: #007bff; color: white;
      text-decoration: none; padding: 10px 20px; border-radius: 5px; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f4f4f4">
    <mj-section padding="20px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#333">
          Hi {{userName}},
        </mj-text>

        <mj-text color="#555" font-size="16px">
          We received a request to reset your password. Click the button below
          to reset it.
        </mj-text>

        <mj-button
          background-color="#007bff"
          color="#fff"
          border-radius="5px"
          href="{{resetLink}}"
        >
          Reset Password
        </mj-button>

        <mj-text font-size="14px" color="#888">
          If you didn’t request a password reset, you can safely ignore this
          email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
